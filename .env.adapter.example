# ============================================================================
# DELTA NEUTRAL BOT CONFIGURATION WITH API ADAPTER SUPPORT
# ============================================================================

# ----------------------------------------------------------------------------
# API ADAPTER SELECTION
# ----------------------------------------------------------------------------
# Specify which DEX platform to use
# Options: lighter, paradex, dydx, hyperliquid, etc.
# Default: lighter (for backward compatibility)
API_ADAPTER=lighter

# ----------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ----------------------------------------------------------------------------
# API endpoint for the selected DEX
# Lighter DEX examples:
#   Testnet: https://testnet.zklighter.elliot.ai
#   Mainnet: https://mainnet.zklighter.elliot.ai
# Paradex examples:
#   Testnet: https://api.testnet.paradex.trade
#   Mainnet: https://api.paradex.trade
BASE_URL=https://testnet.zklighter.elliot.ai

# ----------------------------------------------------------------------------
# ACCOUNT 1 CONFIGURATION (LONG POSITIONS)
# ----------------------------------------------------------------------------
# For Lighter DEX:
ACCOUNT1_PRIVATE_KEY=0xYOUR_ACCOUNT1_PRIVATE_KEY_HERE
ACCOUNT1_INDEX=123456
ACCOUNT1_API_KEY_INDEX=0

# For Paradex (example):
# ACCOUNT1_PRIVATE_KEY=0xYOUR_ACCOUNT1_PRIVATE_KEY_HERE
# ACCOUNT1_ADDRESS=0xYOUR_ACCOUNT1_ADDRESS_HERE
# ACCOUNT1_API_KEY=your_paradex_api_key

# ----------------------------------------------------------------------------
# ACCOUNT 2 CONFIGURATION (SHORT POSITIONS)
# ----------------------------------------------------------------------------
# For Lighter DEX:
ACCOUNT2_PRIVATE_KEY=0xYOUR_ACCOUNT2_PRIVATE_KEY_HERE
ACCOUNT2_INDEX=234567
ACCOUNT2_API_KEY_INDEX=0

# For Paradex (example):
# ACCOUNT2_PRIVATE_KEY=0xYOUR_ACCOUNT2_PRIVATE_KEY_HERE
# ACCOUNT2_ADDRESS=0xYOUR_ACCOUNT2_ADDRESS_HERE
# ACCOUNT2_API_KEY=your_paradex_api_key

# ----------------------------------------------------------------------------
# TRADING PARAMETERS
# ----------------------------------------------------------------------------

# Market Selection
# Comma-separated list of market IDs to trade
# Lighter Markets: 0=ETH, 1=BTC, 2=SOL, 3=DOGE, 7=XRP, 9=AVAX, etc.
MARKET_WHITELIST=0,1,2,3,7,9,24,25,27,35

# Order Sizing
# Option 1: Specify margin amount in USDT (RECOMMENDED)
BASE_AMOUNT_IN_USDT=2.0  # $2 margin per account
# Option 2: Specify base amount in market's native units
# BASE_AMOUNT=100

# Leverage Settings
LEVERAGE=50                    # Default leverage (1-50x depending on market)
USE_DYNAMIC_LEVERAGE=true      # Randomize leverage per trade
LEVERAGE_BUFFER=5              # Random range: (max_leverage - buffer) to max_leverage
MARGIN_MODE=0                  # 0 = cross margin, 1 = isolated margin

# Slippage and Spread Protection
MAX_SLIPPAGE=0.02              # 2% max slippage (0.0 to 1.0)
MAX_SPREAD_PERCENT=0.1         # Reject trades if spread > 0.1% (10 basis points)

# ----------------------------------------------------------------------------
# BOT TIMING CONFIGURATION
# ----------------------------------------------------------------------------

# Time between opening new trades (seconds)
MIN_OPEN_DELAY=80
MAX_OPEN_DELAY=120

# Time before closing positions (seconds)
MIN_CLOSE_DELAY=30
MAX_CLOSE_DELAY=50

# CRITICAL: MIN_OPEN_DELAY must be at least 30 seconds larger than MAX_CLOSE_DELAY
# This ensures new trades only open after old positions are fully closed

# Maximum number of trades to execute (0 = unlimited)
MAX_TRADES=0

# ----------------------------------------------------------------------------
# ADVANCED OPTIONS
# ----------------------------------------------------------------------------

# Use batch transactions when supported by adapter (experimental)
USE_BATCH_MODE=false

# Cache duration for market metadata (seconds)
MARKET_METADATA_TTL_SECONDS=300

# ----------------------------------------------------------------------------
# SAFETY GUARDS
# ----------------------------------------------------------------------------

# Balance Floor Protections
# Stop trading if individual account balance drops below threshold
MIN_ACCOUNT1_BALANCE=250  # Stop if Account 1 < $250
MIN_ACCOUNT2_BALANCE=250  # Stop if Account 2 < $250

# Or use combined balance threshold
# MIN_COMBINED_BALANCE=500  # Stop if total < $500

# Session Bleed Protection
# Stop if cumulative losses exceed this amount (must be ≤ 0)
MAX_SESSION_BLEED=-100  # Stop if losses exceed $100

# ----------------------------------------------------------------------------
# TELEGRAM INTEGRATION (OPTIONAL)
# ----------------------------------------------------------------------------

# Telegram Bot Token from @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Operator Chat IDs (comma-separated for multiple operators)
# Get your chat ID from @userinfobot
# TELEGRAM_OPERATOR_CHAT_ID=123456789,987654321

# Broadcast Channel for Trade Logs (optional)
# Channel IDs typically start with -100
# TELEGRAM_BROADCAST_CHAT_ID=-1001234567890

# ============================================================================
# ADAPTER-SPECIFIC NOTES
# ============================================================================
#
# LIGHTER DEX:
#   - Uses account indices (ACCOUNT1_INDEX, ACCOUNT2_INDEX)
#   - Requires API key indices (ACCOUNT1_API_KEY_INDEX)
#   - Supports up to 50x leverage on select markets
#   - Markets: 0=ETH, 1=BTC, 2=SOL, 3=DOGE, 7=XRP, 9=AVAX, etc.
#
# PARADEX (when implemented):
#   - Uses account addresses instead of indices
#   - May require separate API keys
#   - Different market identifiers
#   - Check Paradex documentation for specifics
#
# DYDX (when implemented):
#   - Uses Stark keys for authentication
#   - Position IDs instead of account indices
#   - Different margin calculations
#   - Check dYdX documentation for specifics
#
# When switching adapters, make sure to:
#   1. Update API_ADAPTER to the new platform
#   2. Update BASE_URL to the new platform's endpoint
#   3. Adjust account configuration to match platform requirements
#   4. Review market IDs (they differ across platforms)
#   5. Check leverage limits (vary by platform and market)
#
# ============================================================================
